#!/usr/bin/env python3
"""libaio's pagure host requires a full clone; keep its pinned submodule commit."""
import os
import sys

args = sys.argv[1:]
if "submodule" in args and "update" in args and any("instanttensor" in a for a in args):
    if "--depth" in args:
        i = args.index("--depth")
        del args[i:i + 2]
os.execv("/usr/bin/git", ["git", *args])
